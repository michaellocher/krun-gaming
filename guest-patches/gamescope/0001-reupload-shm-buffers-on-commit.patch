+gamescope::OwningRc<CVulkanTexture> vulkan_create_texture_from_wlr_buffer( struct wlr_buffer *buf, gamescope::OwningRc<gamescope::IBackendFb> pBackendFb )
+{
+
+	struct wlr_dmabuf_attributes dmabuf = {0};
+	if ( wlr_buffer_get_dmabuf( buf, &dmabuf ) )
+	{
+		return vulkan_create_texture_from_dmabuf( &dmabuf, pBackendFb );
+	}
+
+	void *src;
+	uint32_t drmFormat;
+	size_t stride;
+	if ( !wlr_buffer_begin_data_ptr_access( buf, WLR_BUFFER_DATA_PTR_ACCESS_READ, &src, &drmFormat, &stride ) )
+	{
+		return nullptr;
+	}
+	wlr_buffer_end_data_ptr_access( buf );
+
+	gamescope::OwningRc<CVulkanTexture> pTex = new CVulkanTexture();
+	CVulkanTexture::createFlags texCreateFlags;
+	texCreateFlags.bSampled = true;
+	texCreateFlags.bTransferDst = true;
+	texCreateFlags.bFlippable = true;
+	if ( pTex->BInit( buf->width, buf->height, 1u, drmFormat, texCreateFlags, nullptr, 0, 0, nullptr, pBackendFb ) == false )
+		return nullptr;
+
+	if ( !copy_wlr_buffer_pixels( buf, pTex.get() ) )
+		return nullptr;
+
 	return pTex;
 }
+
+// A wl_shm buffer's texture is a copy taken when it was created: a client that commits the same buffer again
+// (Xwayland without glamor cycles a few of them) needs the copy refreshed, or the old contents are shown.
+bool vulkan_update_texture_from_wlr_buffer( CVulkanTexture *pTex, struct wlr_buffer *buf )
+{
+	struct wlr_dmabuf_attributes dmabuf = {0};
+	if ( wlr_buffer_get_dmabuf( buf, &dmabuf ) )
+		return true; // the texture shares the client's memory
+
+	return copy_wlr_buffer_pixels( buf, pTex );
+}
