+bool
+mtl_linear_texture_ok(mtl_device *device, const struct kk_image_layout *layout, uint64_t offset)
+{
+   MTLPixelFormat format = layout->format.mtl;
+   MTLTextureType type = (MTLTextureType)layout->type;
+   if (type != MTLTextureType2D && type != MTLTextureType1D)
+      return false;
+   if (layout->levels != 1 || layout->sample_count_sa > 1 || layout->layers > 1 || layout->depth_px > 1)
+      return false;
+   /* compressed (BC, PVRTC, ETC/EAC, ASTC) and depth/stencil formats: no linear textures */
+   if (format >= MTLPixelFormatBC1_RGBA && format <= MTLPixelFormatX24_Stencil8)
+      return false;
+   @autoreleasepool {
+      NSUInteger align = [(id<MTLDevice>)device minimumLinearTextureAlignmentForPixelFormat:format];
+      return align && offset % align == 0 && layout->linear_stride_B % align == 0;
+   }
+}
+
+mtl_texture *
+mtl_new_standalone_texture(mtl_device *device,
+                           const struct kk_image_layout *layout)
+{
+   @autoreleasepool {
+      id<MTLDevice> dev = (id<MTLDevice>)device;
+      MTLTextureDescriptor *descriptor = [mtl_new_texture_descriptor(layout) autorelease];
+      /* shared, not private: Venus also fills images from the CPU (vkCopyMemoryToImage -> replaceRegion) */
+      descriptor.storageMode = MTLStorageModeShared;
+      return [dev newTextureWithDescriptor:descriptor];
+   }
+}
