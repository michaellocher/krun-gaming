+/* krun-gaming: poly intrinsics of the transform feedback passes. KK exposes no
+ * pipeline statistics (address 0: not counted) and has no zero page, so a
+ * read-only pointer is writable as is (Honeykrisp: hk_nir_lower_descriptors,
+ * agx_compile). */
+static bool
+kk_lower_poly_xfb_intrinsics(nir_builder *b, nir_intrinsic_instr *intr,
+                             void *data)
+{
+   switch (intr->intrinsic) {
+   case nir_intrinsic_load_stat_query_address_poly:
+      b->cursor = nir_before_instr(&intr->instr);
+      nir_def_replace(&intr->def, nir_imm_int64(b, 0));
+      return true;
+   case nir_intrinsic_ro_to_rw_poly:
+      nir_def_replace(&intr->def, intr->src[0].ssa);
+      return true;
+   default:
+      return false;
+   }
+}
+
 static VkResult
 kk_compile_shader(struct kk_device *dev, nir_shader *nir,
                   struct kk_shader *prev_stage,
@@ -1143,14 +1176,32 @@ kk_compile_shader(struct kk_device *dev, nir_shader *nir,
       NIR_PASS(_, nir, poly_nir_lower_gs, &count, &rast, &pre_gs,
                &shader->info.gs);
 
-      /* Only transform feedback and pipeline statistics need these, and KK
-       * exposes neither */
-      ralloc_free(count);
-      ralloc_free(pre_gs);
+      /* krun-gaming: transform feedback needs the count and pre-GS passes
+       * (pipeline statistics would too; KK does not expose them) */
+      if (shader->info.gs.xfb) {
+         /* kk_compile_msl frees the shader it compiles */
+         if (count) {
+            count->info.stage = MESA_SHADER_COMPUTE;
+            count->xfb_info = NULL;
+            NIR_PASS(_, count, nir_shader_intrinsics_pass,
+                     kk_lower_poly_xfb_intrinsics, nir_metadata_control_flow,
+                     NULL);
+            kk_compile_msl(pdev, count, state, &shader->gs_count);
+         }
+         pre_gs->info.stage = MESA_SHADER_COMPUTE;
+         NIR_PASS(_, pre_gs, nir_shader_intrinsics_pass,
+                  kk_lower_poly_xfb_intrinsics, nir_metadata_control_flow, NULL);
+         kk_compile_msl(pdev, pre_gs, state, &shader->gs_pre);
+      } else {
+         ralloc_free(count);
+         ralloc_free(pre_gs);
+      }
 
       nir->info.stage = MESA_SHADER_COMPUTE;
       memset(&nir->info.cs, 0, sizeof(nir->info.cs));
       nir->xfb_info = NULL;
+      NIR_PASS(_, nir, nir_shader_intrinsics_pass, kk_lower_poly_xfb_intrinsics,
+               nir_metadata_control_flow, NULL);
       kk_compile_msl(pdev, nir, state, &shader->gs_main);
 
       /* From here on, nir is the rasterization VS of the GS */
@@ -1468,6 +1519,10 @@ gather_graphics_pipeline_create_info(
 
       if (s->info.stage == MESA_SHADER_GEOMETRY) {
          kk_msl_copy(&vs->gs_main, &s->gs_main);
+         if (s->gs_count.code)
