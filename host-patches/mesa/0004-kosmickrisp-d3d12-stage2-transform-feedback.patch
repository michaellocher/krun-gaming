@@ -619,19 +618,43 @@ kk_CmdCopyQueryPoolResultsToMemoryKHR(
    libkk_copy_queries_struct(cmd, kk_grid_1d(queryCount), false, args);
 }
 
-/* krun-gaming: VK_EXT_transform_feedback stage 1 — indexed queries for the
- * transform-feedback stream query (results stay 0, see kk_reports_per_query) */
+/* krun-gaming: VK_EXT_transform_feedback stream query. Report 0 counts the
+ * primitives written, report 1 the primitives needed; the poly pre-GS pass adds
+ * to both while the query is active (Honeykrisp: hk_cmd_begin_end_query). */
 VKAPI_ATTR void VKAPI_CALL
 kk_CmdBeginQueryIndexedEXT(VkCommandBuffer commandBuffer, VkQueryPool queryPool,
                            uint32_t query, VkQueryControlFlags flags,
                            uint32_t index)
 {
-   kk_CmdBeginQuery(commandBuffer, queryPool, query, flags);
+   VK_FROM_HANDLE(kk_cmd_buffer, cmd, commandBuffer);
+   VK_FROM_HANDLE(kk_query_pool, pool, queryPool);
+   struct kk_device *dev = kk_cmd_buffer_device(cmd);
+
+   if (pool->vk.query_type != VK_QUERY_TYPE_TRANSFORM_FEEDBACK_STREAM_EXT) {
+      kk_CmdBeginQuery(commandBuffer, queryPool, query, flags);
+      return;
+   }
+
+   /* Zero now, not deferred past the render pass like kk_cmd_write */
+   uint64_t report = kk_query_report_addr(dev, pool, query);
+   for (uint32_t i = 0; i < 4; ++i)
+      libkk_write_u32(cmd, kk_grid_1d(1), true, report + i * sizeof(uint32_t),
+                      0u);
+
+   assert(index < ARRAY_SIZE(cmd->state.gfx.xfb.query));
+   cmd->state.gfx.xfb.query[index] = report;
 }
 
 VKAPI_ATTR void VKAPI_CALL
 kk_CmdEndQueryIndexedEXT(VkCommandBuffer commandBuffer, VkQueryPool queryPool,
                          uint32_t query, uint32_t index)
 {
+   VK_FROM_HANDLE(kk_cmd_buffer, cmd, commandBuffer);
+   VK_FROM_HANDLE(kk_query_pool, pool, queryPool);
+
+   if (pool->vk.query_type == VK_QUERY_TYPE_TRANSFORM_FEEDBACK_STREAM_EXT &&
+       index < ARRAY_SIZE(cmd->state.gfx.xfb.query))
+      cmd->state.gfx.xfb.query[index] = 0;
+
    kk_CmdEndQuery(commandBuffer, queryPool, query);
 }
