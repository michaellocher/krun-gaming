From: krun-gaming
Subject: [PATCH] kosmickrisp: D3D12 stage 2 — transform feedback capture

Port of Honeykrisp's transform feedback onto the shared poly GS emulation:
the count, prefix-sum and pre-GS passes run before the main GS, which writes
the captured vertices; Bind/Begin/End save and restore the counters, stream
queries count primitives, vkCmdDrawIndirectByteCountEXT derives the vertex
count on the GPU. A VS/TES with transform feedback and no API GS gets a
generated passthrough GS (owned by the VS, serialized with it). vkd3d-proton
stream output tests: 156/156 checks pass.
---
diff --git a/src/kosmickrisp/libkk/kk_geometry.cl b/src/kosmickrisp/libkk/kk_geometry.cl
index dd102f9..7fb12a4 100644
--- a/src/kosmickrisp/libkk/kk_geometry.cl
+++ b/src/kosmickrisp/libkk/kk_geometry.cl
@@ -9,6 +9,7 @@
 #include "compiler/libcl/libcl_vk.h"
 #include "poly/geometry.h"
 #include "poly/tessellator.h"
+#include "kk_query.h"
 
 KERNEL(1024)
 libkk_prefix_sum_tess(global struct poly_tess_params *p)
@@ -50,10 +51,42 @@ libkk_gs_setup_indirect(uint64_t index_buffer, constant uint *draw,
                         global struct poly_heap *heap, uint64_t vs_outputs,
                         uint32_t index_size_B, uint32_t index_buffer_range_el,
                         uint32_t prim, uint32_t max_indices,
-                        enum poly_gs_shape shape)
+                        enum poly_gs_shape shape, uint32_t is_prefix_summing)
 {
    /* Prefix summing only serves transform feedback */
    poly_gs_setup_indirect(index_buffer, draw, vp, p, heap, vs_outputs,
                           index_size_B, index_buffer_range_el, prim,
-                          false /* is_prefix_summing */, max_indices, shape);
+                          is_prefix_summing, max_indices, shape);
+}
+
+/* krun-gaming: transform feedback, as Honeykrisp (libagx geometry.cl, query.cl) */
+KERNEL(1024)
+libkk_prefix_sum_geom(constant struct poly_geometry_params *p)
+{
+   local uint scratch[32];
+   poly_prefix_sum(scratch, p->count_buffer, p->input_primitives,
+                   p->count_buffer_stride / 4, cl_group_id.x, 1024);
+}
+
+KERNEL(4)
+libkk_copy_xfb_counters(constant struct libkk_xfb_counter_copy *push)
+{
+   unsigned i = cl_local_id.x;
+
+   *(push->dest[i]) = push->src[i] ? *(push->src[i]) : 0;
+}
+
+/* vkCmdDrawIndirectByteCountEXT: the vertex count from a transform feedback
+ * counter, as a VkDrawIndirectCommand */
+KERNEL(1)
+libkk_draw_indirect_byte_count(global uint *out, constant uint *counter,
+                               uint counter_offset, uint vertex_stride,
+                               uint instance_count, uint first_instance)
+{
+   uint bytes = *counter;
+   out[0] = bytes > counter_offset ? (bytes - counter_offset) / vertex_stride
+                                   : 0;
+   out[1] = instance_count;
+   out[2] = 0;
+   out[3] = first_instance;
 }
diff --git a/src/kosmickrisp/libkk/kk_query.h b/src/kosmickrisp/libkk/kk_query.h
index 5688740..5d676cf 100644
--- a/src/kosmickrisp/libkk/kk_query.h
