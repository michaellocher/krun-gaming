+/* krun-gaming: transform feedback counter save/restore (Begin/EndTransformFeedback) */
+struct libkk_xfb_counter_copy {
+   DEVICE(uint32_t) dest[4];
+   DEVICE(uint32_t) src[4];
+};
+
 #define LIBKK_QUERY_UNAVAILABLE (uint64_t)((int64_t)-1)
 
 #endif /* KK_QUERY_H */
diff --git a/src/kosmickrisp/vulkan/kk_cmd_buffer.h b/src/kosmickrisp/vulkan/kk_cmd_buffer.h
