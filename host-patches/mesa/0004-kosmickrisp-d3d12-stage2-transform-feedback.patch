diff --git a/src/kosmickrisp/vulkan/kk_cmd_draw.c b/src/kosmickrisp/vulkan/kk_cmd_draw.c
index 48fe619..89af618 100644
--- a/src/kosmickrisp/vulkan/kk_cmd_draw.c
+++ b/src/kosmickrisp/vulkan/kk_cmd_draw.c
@@ -1298,6 +1298,31 @@ kk_upload_geometry_params(struct kk_cmd_buffer *cmd,
    struct poly_geometry_params params;
    poly_geometry_params_init(&params, mode, wg_size);
 
+   /* krun-gaming: transform feedback, as Honeykrisp's hk_upload_geometry_params.
+    * poly writes counters unconditionally, so unused ones go to a zeroed
+    * scratch area (KK has no zero/scratch page). */
+   static const uint32_t zeros[16];
+   uint64_t scratch = kk_pool_upload(cmd, zeros, sizeof(zeros), 16).gpu;
+   for (unsigned i = 0; i < ARRAY_SIZE(gfx->xfb.buffers); ++i) {
+      bool on = gfx->xfb.enabled;
+      params.xfb_base_original[i] = on ? gfx->xfb.buffers[i].addr : scratch;
+      params.xfb_size[i] = on ? gfx->xfb.buffers[i].range : 0;
+      params.xfb_offs_ptrs[i] =
+         on ? gfx->xfb.offsets + i * sizeof(uint32_t) : scratch;
+   }
+   for (unsigned i = 0; i < ARRAY_SIZE(gfx->xfb.query); ++i) {
+      uint64_t q = gfx->xfb.query[i];
+      params.xfb_prims_generated_counter[i] = q ? q : scratch;
+      params.prims_generated_counter[i] = q ? q + sizeof(uint64_t) : scratch;
+      params.xfb_overflow[i] = scratch;
+   }
+   params.xfb_any_overflow = scratch;
+
+   params.count_buffer_stride = gs->info.gs.count_words * 4;
+   /* read as zero, so separate from the written scratch */
+   if (!gs->info.gs.prefix_sum && params.count_buffer_stride)
+      params.count_buffer = kk_pool_upload(cmd, zeros, 16, 4).gpu;
+
    if (indirect) {
       /* The indirect setup kernel writes the draw and allocates from the
        * heap, including the index buffer */
@@ -1307,6 +1332,10 @@ kk_upload_geometry_params(struct kk_cmd_buffer *cmd,
       poly_geometry_params_set_draw(&params, mode, shape, max_indices,
                                     draw->grid.size.x, draw->grid.size.y);
 
+      uint32_t count_B = params.input_primitives * params.count_buffer_stride;
+      if (gs->info.gs.prefix_sum && count_B)
+         params.count_buffer = kk_pool_alloc(cmd, count_B, 4).gpu;
+
       gfx->gs.index_count = params.draw.index_count;
       gfx->gs.instance_count = params.draw.instance_count;
 
@@ -2241,6 +2270,7 @@ kk_launch_gs_prerast(struct kk_cmd_buffer *cmd,
          .prim = mode,
          .max_indices = gs->info.gs.max_indices,
          .shape = shape,
+         .is_prefix_summing = gs->info.gs.prefix_sum,
       };
 
       if (draw.index.el_size_B) {
@@ -2276,6 +2306,30 @@ kk_launch_gs_prerast(struct kk_cmd_buffer *cmd,
       enc, vs->pipeline.gfx.pre_render[pre_render_count - 2u]);
    kk_dispatch_compute(enc, grid_vs, local_size);
 
+   /* krun-gaming: transform feedback, in Honeykrisp's order (hk_launch_gs):
+    * count the outputs, prefix-sum them, then the 1x1x1 pre-GS pass sizes the
+    * capture, updates offsets and queries, before the main GS writes */
+   if (gs->info.gs.xfb) {
+      if (vs->pipeline.gfx.gs_count) {
+         mtl_barrier_after_encoder_stages(enc, MTL_STAGE_DISPATCH,
+                                          MTL_STAGE_DISPATCH);
+         mtl_compute_set_pipeline_state(enc, vs->pipeline.gfx.gs_count);
+         kk_dispatch_compute(enc, grid_gs, local_size);
+      }
+      if (gs->info.gs.prefix_sum) {
+         libkk_prefix_sum_geom(cmd,
+                               kk_grid_1d(1024u * gs->info.gs.count_words),
+                               true, geometry_params);
+         enc = cs_get_compute(cmd);
+      }
+      if (vs->pipeline.gfx.gs_pre) {
+         mtl_barrier_after_encoder_stages(enc, MTL_STAGE_DISPATCH,
+                                          MTL_STAGE_DISPATCH);
+         mtl_compute_set_pipeline_state(enc, vs->pipeline.gfx.gs_pre);
+         kk_dispatch_compute(enc, kk_grid_1d(1u), (struct mtl_size){1, 1, 1});
+      }
+   }
+
    mtl_barrier_after_encoder_stages(enc, MTL_STAGE_DISPATCH,
                                     MTL_STAGE_DISPATCH);
    mtl_compute_set_pipeline_state(
@@ -2710,19 +2764,9 @@ kk_CmdDrawIndexedIndirectCount2KHR(VkCommandBuffer commandBuffer,
    kk_draw(cmd, &data);
 }
 
-/* krun-gaming: VK_EXT_transform_feedback stage 1. vkd3d-proton (D3D12) refuses a
- * device without the extension; few games use stream output. Binding, begin and
- * end are accepted but capture nothing yet, and byte-count draws draw nothing.
- * Stage 2 wires these to the poly geometry path (count/pre_gs, as Honeykrisp). */
-static void
-kk_xfb_stub_warn(const char *what)
-{
-   static bool warned;
-   if (!warned)
-      mesa_logw("kosmickrisp: %s: transform feedback is not captured yet", what);
-   warned = true;
-}
-
+/* krun-gaming: VK_EXT_transform_feedback, captured by the poly GS path as in
+ * Honeykrisp (hk_cmd_draw.c). Vertex-only pipelines with transform feedback
+ * get a passthrough GS at pipeline creation (kk_shader.c). */
 VKAPI_ATTR void VKAPI_CALL
 kk_CmdBindTransformFeedbackBuffersEXT(VkCommandBuffer commandBuffer,
                                       uint32_t firstBinding,
@@ -2731,6 +2775,62 @@ kk_CmdBindTransformFeedbackBuffersEXT(VkCommandBuffer commandBuffer,
                                       const VkDeviceSize *pOffsets,
                                       const VkDeviceSize *pSizes)
 {
+   VK_FROM_HANDLE(kk_cmd_buffer, cmd, commandBuffer);
+   struct kk_graphics_state *gfx = &cmd->state.gfx;
+
+   for (uint32_t i = 0; i < bindingCount; ++i) {
+      VK_FROM_HANDLE(kk_buffer, buffer, pBuffers[i]);
+      uint32_t idx = firstBinding + i;
+      uint64_t size = pSizes ? pSizes[i] : VK_WHOLE_SIZE;
+
+      gfx->xfb.buffers[idx] = kk_buffer_addr_range(buffer, pOffsets[i], size);
+   }
+}
+
+/* Begin loads the counter buffers into the offsets the GS passes advance, end
+ * stores them back; missing counter buffers start at 0 */
+static void
+kk_begin_end_xfb(struct kk_cmd_buffer *cmd, uint32_t firstCounterBuffer,
+                 uint32_t counterBufferCount, const VkBuffer *pCounterBuffers,
+                 const VkDeviceSize *pCounterBufferOffsets, bool begin)
+{
+   struct kk_graphics_state *gfx = &cmd->state.gfx;
+
+   gfx->xfb.enabled = begin;
+   if (begin)
+      gfx->xfb.offsets = kk_pool_alloc(cmd, 4 * sizeof(uint32_t), 4).gpu;
+
+   static const uint32_t zero;
+   uint64_t zero_addr = kk_pool_upload(cmd, &zero, sizeof(zero), 4).gpu;
+   uint64_t sink = kk_pool_alloc(cmd, 4 * sizeof(uint32_t), 4).gpu;
+
+   struct libkk_xfb_counter_copy params = {0};
+   for (unsigned i = 0; i < 4; ++i) {
+      params.dest[i] = begin ? gfx->xfb.offsets + i * sizeof(uint32_t)
+                             : sink + i * sizeof(uint32_t);
+      params.src[i] = begin ? zero_addr : sink + i * sizeof(uint32_t);
+   }
+
+   for (uint32_t i = 0; i < counterBufferCount; ++i) {
+      if (pCounterBuffers == NULL || pCounterBuffers[i] == VK_NULL_HANDLE)
+         continue;
+
+      VK_FROM_HANDLE(kk_buffer, buffer, pCounterBuffers[i]);
+      uint64_t offset = pCounterBufferOffsets ? pCounterBufferOffsets[i] : 0;
+      uint64_t counter = vk_buffer_address(&buffer->vk, offset);
+      uint32_t idx = firstCounterBuffer + i;
+      uint64_t slot = gfx->xfb.offsets + idx * sizeof(uint32_t);
+
+      if (begin) {
+         params.src[idx] = counter;
+      } else {
+         params.dest[idx] = counter;
+         params.src[idx] = slot;
+      }
+   }
+
+   uint64_t params_addr = kk_pool_upload(cmd, &params, sizeof(params), 8).gpu;
+   libkk_copy_xfb_counters(cmd, kk_grid_1d(4), true, params_addr);
 }
 
 VKAPI_ATTR void VKAPI_CALL
@@ -2740,7 +2840,9 @@ kk_CmdBeginTransformFeedbackEXT(VkCommandBuffer commandBuffer,
                                 const VkBuffer *pCounterBuffers,
                                 const VkDeviceSize *pCounterBufferOffsets)
 {
-   kk_xfb_stub_warn("vkCmdBeginTransformFeedbackEXT");
+   VK_FROM_HANDLE(kk_cmd_buffer, cmd, commandBuffer);
+   kk_begin_end_xfb(cmd, firstCounterBuffer, counterBufferCount,
+                    pCounterBuffers, pCounterBufferOffsets, true);
 }
 
 VKAPI_ATTR void VKAPI_CALL
@@ -2750,6 +2852,9 @@ kk_CmdEndTransformFeedbackEXT(VkCommandBuffer commandBuffer,
                               const VkBuffer *pCounterBuffers,
                               const VkDeviceSize *pCounterBufferOffsets)
 {
+   VK_FROM_HANDLE(kk_cmd_buffer, cmd, commandBuffer);
+   kk_begin_end_xfb(cmd, firstCounterBuffer, counterBufferCount,
+                    pCounterBuffers, pCounterBufferOffsets, false);
 }
 
 VKAPI_ATTR void VKAPI_CALL
@@ -2759,5 +2864,33 @@ kk_CmdDrawIndirectByteCountEXT(VkCommandBuffer commandBuffer,
                                VkDeviceSize counterBufferOffset,
                                uint32_t counterOffset, uint32_t vertexStride)
 {
-   kk_xfb_stub_warn("vkCmdDrawIndirectByteCountEXT");
+   VK_FROM_HANDLE(kk_cmd_buffer, cmd, commandBuffer);
+   VK_FROM_HANDLE(kk_buffer, counter, counterBuffer);
+
+   if (vertexStride == 0)
+      return;
+
+   uint64_t draw = kk_pool_alloc(cmd, 4 * sizeof(uint32_t), 4).gpu;
+   libkk_draw_indirect_byte_count(
+      cmd, kk_grid_1d(1), true, draw,
+      vk_buffer_address(&counter->vk, counterBufferOffset), counterOffset,
+      vertexStride, instanceCount, firstInstance);
+
+   const struct vk_dynamic_graphics_state *dyn =
+      &cmd->vk.dynamic_graphics_state;
+   struct kk_draw_command data = {
+      .prim = vk_topology_to_mesa(dyn->ia.primitive_topology),
+      .upload_mask = build_per_draw_upload_mask(cmd),
+      .indirect = true,
+      .predicate_count = cmd->state.cond_render.enabled ? 1u : 0u,
+      .predicate_op[0] = cmd->state.cond_render.inverted
+                            ? KK_PREDICATE_EQ_ZERO
+                            : KK_PREDICATE_NEQ_ZERO,
+      .draw_count = 1u,
+      .predicate_addr[0] = cmd->state.cond_render.address,
+      .indirect_command.addr = draw,
+      .indirect_command.stride = 4 * sizeof(uint32_t),
+   };
+
+   kk_draw(cmd, &data);
 }
diff --git a/src/kosmickrisp/vulkan/kk_query_pool.c b/src/kosmickrisp/vulkan/kk_query_pool.c
