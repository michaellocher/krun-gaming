+   pthread_mutex_lock(&vkr_metal_share_mutex);
+   for (uint32_t i = 0; i < vkr_metal_share_count; i++) {
+      if (vkr_metal_shares[i].res_id == res_id) {
+         *heap = vkr_metal_shares[i].heap;
+         *memory_type_index = vkr_metal_shares[i].memory_type_index;
+         *allocation_size = vkr_metal_shares[i].allocation_size;
+         found = true;
+         break;
+      }
+   }
+   pthread_mutex_unlock(&vkr_metal_share_mutex);
+   return found;
+}
+
+static void
+vkr_metal_share_forget_matching(uint32_t res_id, uint32_t ctx_id, bool any_res)
+{
+   pthread_mutex_lock(&vkr_metal_share_mutex);
+   for (uint32_t i = 0; i < vkr_metal_share_count;) {
+      struct vkr_metal_share *share = &vkr_metal_shares[i];
+      if (share->ctx_id == ctx_id && (any_res || share->res_id == res_id)) {
+         vkr_metal_release(share->heap);
+         *share = vkr_metal_shares[--vkr_metal_share_count];
+      } else {
+         i++;
+      }
+   }
+   pthread_mutex_unlock(&vkr_metal_share_mutex);
