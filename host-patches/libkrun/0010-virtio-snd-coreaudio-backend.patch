diff --git a/src/devices/src/virtio/snd/audio_backends/coreaudio.rs b/src/devices/src/virtio/snd/audio_backends/coreaudio.rs
new file mode 100644
index 00000000..6ddba627
--- /dev/null
+++ b/src/devices/src/virtio/snd/audio_backends/coreaudio.rs
@@ -0,0 +1,384 @@
+// CoreAudio (AudioToolbox AudioQueue) backend for macOS hosts: playback streams feed guest PCM periods to an
+// output AudioQueue; capture streams fill the guest's periods from an input AudioQueue (the default input device;
+// macOS asks for microphone access once, attributed to the app that started the VM, e.g. the terminal).
+// SPDX-License-Identifier: Apache-2.0 or BSD-3-Clause
+
+use std::{
+    collections::HashMap,
+    ffi::c_void,
+    ptr,
+    sync::{Arc, Mutex, RwLock},
+};
+
+use log::error;
+
+use super::super::{
+    stream::{Error as StreamError, PCMState},
+    virtio_sound::{
+        VirtioSndPcmSetParams, VIRTIO_SND_PCM_FMT_S16, VIRTIO_SND_PCM_FMT_S24,
+        VIRTIO_SND_PCM_FMT_S32, VIRTIO_SND_PCM_FMT_U8, VIRTIO_SND_PCM_RATE_11025,
+        VIRTIO_SND_PCM_RATE_16000, VIRTIO_SND_PCM_RATE_22050, VIRTIO_SND_PCM_RATE_32000,
+        VIRTIO_SND_PCM_RATE_44100, VIRTIO_SND_PCM_RATE_48000, VIRTIO_SND_PCM_RATE_8000,
+    },
+    Direction, Error, Result, Stream,
+};
+use super::AudioBackend;
+
+type OSStatus = i32;
+type AudioQueueRef = *mut c_void;
+
+#[repr(C)]
+struct AudioStreamBasicDescription {
+    sample_rate: f64,
+    format_id: u32,
+    format_flags: u32,
+    bytes_per_packet: u32,
+    frames_per_packet: u32,
+    bytes_per_frame: u32,
+    channels_per_frame: u32,
+    bits_per_channel: u32,
+    reserved: u32,
+}
+
+#[repr(C)]
+struct AudioQueueBuffer {
+    audio_data_bytes_capacity: u32,
+    audio_data: *mut c_void,
+    audio_data_byte_size: u32,
+    user_data: *mut c_void,
+    packet_description_capacity: u32,
+    packet_descriptions: *mut c_void,
+    packet_description_count: u32,
+}
+type AudioQueueBufferRef = *mut AudioQueueBuffer;
+
+type AudioQueueOutputCallback = extern "C" fn(*mut c_void, AudioQueueRef, AudioQueueBufferRef);
+type AudioQueueInputCallback =
+    extern "C" fn(*mut c_void, AudioQueueRef, AudioQueueBufferRef, *const c_void, u32, *const c_void);
+
+#[link(name = "AudioToolbox", kind = "framework")]
+extern "C" {
+    fn AudioQueueNewOutput(
+        format: *const AudioStreamBasicDescription,
+        callback: AudioQueueOutputCallback,
+        user_data: *mut c_void,
+        run_loop: *const c_void,
+        run_loop_mode: *const c_void,
+        flags: u32,
+        out_queue: *mut AudioQueueRef,
+    ) -> OSStatus;
+    fn AudioQueueNewInput(
+        format: *const AudioStreamBasicDescription,
+        callback: AudioQueueInputCallback,
+        user_data: *mut c_void,
+        run_loop: *const c_void,
+        run_loop_mode: *const c_void,
+        flags: u32,
+        out_queue: *mut AudioQueueRef,
+    ) -> OSStatus;
+    fn AudioQueueAllocateBuffer(queue: AudioQueueRef, size: u32, out: *mut AudioQueueBufferRef) -> OSStatus;
+    fn AudioQueueEnqueueBuffer(queue: AudioQueueRef, buf: AudioQueueBufferRef, n: u32, d: *const c_void) -> OSStatus;
+    fn AudioQueueStart(queue: AudioQueueRef, start_time: *const c_void) -> OSStatus;
+    fn AudioQueuePause(queue: AudioQueueRef) -> OSStatus;
+    fn AudioQueueDispose(queue: AudioQueueRef, immediate: u8) -> OSStatus;
+}
+
+const K_AUDIO_FORMAT_LINEAR_PCM: u32 = u32::from_be_bytes(*b"lpcm");
+const K_FLAG_SIGNED_INTEGER: u32 = 1 << 2;
+const K_FLAG_PACKED: u32 = 1 << 3;
+// host buffers in flight per stream: enough to ride out scheduling jitter, few enough for low latency
+const QUEUE_BUFFERS: usize = 3;
+
+/// What the AudioQueue callback needs; boxed, owned by `Queue`, freed after the queue is disposed.
+struct CallbackContext {
+    streams: Arc<RwLock<Vec<Stream>>>,
+    stream_id: usize,
+}
+
+struct Queue {
+    queue: AudioQueueRef,
+    context: *mut CallbackContext,
+}
+
+impl Drop for Queue {
+    fn drop(&mut self) {
+        // SAFETY: the queue was created by AudioQueueNewOutput; disposing it synchronously stops callbacks
+        // before the context they use is freed.
+        unsafe {
+            AudioQueueDispose(self.queue, 1);
+            drop(Box::from_raw(self.context));
+        }
+    }
+}
+
+pub struct CoreAudioBackend {
+    streams: Arc<RwLock<Vec<Stream>>>,
+    queues: Mutex<HashMap<u32, Queue>>,
+}
+
+// SAFETY: the raw AudioQueue handles are only used under the `queues` mutex; AudioQueue is thread-safe.
+unsafe impl Send for CoreAudioBackend {}
+// SAFETY: see Send.
+unsafe impl Sync for CoreAudioBackend {}
+
+impl CoreAudioBackend {
+    pub fn new(streams: Arc<RwLock<Vec<Stream>>>) -> Self {
+        Self { streams, queues: Mutex::new(HashMap::new()) }
+    }
+
+    fn stream_state(&self, stream_id: u32) -> Result<PCMState> {
+        self.streams
+            .read()
+            .unwrap()
+            .get(stream_id as usize)
+            .map(|s| s.state)
+            .ok_or(Error::StreamWithIdNotFound(stream_id))
+    }
+}
+
+fn rate_hz(rate: u8) -> f64 {
+    match rate {
+        VIRTIO_SND_PCM_RATE_8000 => 8000.0,
+        VIRTIO_SND_PCM_RATE_11025 => 11025.0,
+        VIRTIO_SND_PCM_RATE_16000 => 16000.0,
+        VIRTIO_SND_PCM_RATE_22050 => 22050.0,
+        VIRTIO_SND_PCM_RATE_32000 => 32000.0,
+        VIRTIO_SND_PCM_RATE_44100 => 44100.0,
+        VIRTIO_SND_PCM_RATE_48000 => 48000.0,
+        _ => 44100.0,
+    }
+}
+
+/// LPCM description of a virtio-snd format: (bits per sample, bytes per sample container, signed)
+fn sample_layout(format: u8) -> Option<(u32, u32, bool)> {
+    match format {
+        VIRTIO_SND_PCM_FMT_U8 => Some((8, 1, false)),
+        VIRTIO_SND_PCM_FMT_S16 => Some((16, 2, true)),
+        VIRTIO_SND_PCM_FMT_S24 => Some((24, 4, true)), // 24 bits, low-aligned in 32 (ALSA S24_LE)
+        VIRTIO_SND_PCM_FMT_S32 => Some((32, 4, true)),
+        _ => None,
+    }
+}
+
+/// Fills one host buffer from the guest's queued periods (silence where the guest is behind) and requeues it.
+extern "C" fn output_callback(user_data: *mut c_void, queue: AudioQueueRef, buf: AudioQueueBufferRef) {
+    // SAFETY: user_data is the CallbackContext owned by the Queue, alive until AudioQueueDispose returns;
+    // buf is a buffer of this queue with audio_data_bytes_capacity bytes.
+    unsafe {
+        let ctx = &*(user_data as *const CallbackContext);
+        let capacity = (*buf).audio_data_bytes_capacity as usize;
+        let out = std::slice::from_raw_parts_mut((*buf).audio_data as *mut u8, capacity);
+        let mut filled = 0;
+        if let Ok(mut streams) = ctx.streams.write() {
+            if let Some(stream) = streams.get_mut(ctx.stream_id) {
+                while filled < capacity {
+                    let Some(period) = stream.buffers.front_mut() else { break };
+                    let avail = (period.desc_len() as usize).saturating_sub(period.pos);
+                    let n = avail.min(capacity - filled);
+                    if n > 0 && period.read_output(&mut out[filled..filled + n]).is_err() {
+                        break;
+                    }
+                    period.pos += n;
+                    filled += n;
+                    if period.pos >= period.desc_len() as usize {
+                        stream.buffers.pop_front(); // dropping it completes the period for the guest
+                    }
+                }
+            }
+        }
+        ptr::write_bytes(out.as_mut_ptr().add(filled), 0, capacity - filled);
+        (*buf).audio_data_byte_size = capacity as u32;
+        AudioQueueEnqueueBuffer(queue, buf, 0, ptr::null());
+    }
+}
+
+/// Copies one filled host buffer into the guest's queued capture periods (dropped where the guest has none) and
+/// hands the buffer back to the queue.
+extern "C" fn input_callback(
+    user_data: *mut c_void,
+    queue: AudioQueueRef,
+    buf: AudioQueueBufferRef,
+    _start_time: *const c_void,
+    _packets: u32,
+    _packet_descs: *const c_void,
+) {
+    // SAFETY: as in output_callback; audio_data_byte_size bytes of buf are valid recorded data.
+    unsafe {
+        let ctx = &*(user_data as *const CallbackContext);
+        let data = std::slice::from_raw_parts((*buf).audio_data as *const u8, (*buf).audio_data_byte_size as usize);
+        let mut done = 0;
+        if let Ok(mut streams) = ctx.streams.write() {
+            if let Some(stream) = streams.get_mut(ctx.stream_id) {
+                while done < data.len() {
+                    let Some(period) = stream.buffers.front_mut() else { break };
+                    let avail = (period.desc_len() as usize).saturating_sub(period.pos);
+                    let n = avail.min(data.len() - done);
+                    // write_input advances period.pos itself
+                    if n == 0 || period.write_input(&data[done..done + n]).unwrap_or(0) == 0 {
+                        stream.buffers.pop_front();
+                        continue;
+                    }
+                    done += n;
+                    if period.pos >= period.desc_len() as usize {
+                        stream.buffers.pop_front(); // dropping it completes the period for the guest
+                    }
+                }
+            }
+        }
+        AudioQueueEnqueueBuffer(queue, buf, 0, ptr::null());
+    }
+}
+
+impl AudioBackend for CoreAudioBackend {
+    fn write(&self, stream_id: u32) -> Result<()> {
+        match self.stream_state(stream_id)? {
+            PCMState::Start | PCMState::Prepare => Ok(()),
+            state => Err(Error::Stream(StreamError::InvalidState("write", state))),
+        }
+    }
+
+    fn read(&self, stream_id: u32) -> Result<()> {
+        match self.stream_state(stream_id)? {
+            PCMState::Start | PCMState::Prepare => Ok(()),
+            state => Err(Error::Stream(StreamError::InvalidState("read", state))),
+        }
+    }
+
+    fn set_parameters(&self, stream_id: u32, request: VirtioSndPcmSetParams) -> Result<()> {
+        let mut streams = self.streams.write().unwrap();
+        let st = streams.get_mut(stream_id as usize).ok_or(Error::StreamWithIdNotFound(stream_id))?;
+        st.state.set_parameters().map_err(Error::Stream)?;
+        if !st.supports_format(request.format)
+            || !st.supports_rate(request.rate)
+            || sample_layout(request.format).is_none()
+        {
+            return Err(Error::UnexpectedAudioBackendConfiguration);
+        }
+        st.params.features = request.features;
+        st.params.buffer_bytes = request.buffer_bytes;
+        st.params.period_bytes = request.period_bytes;
+        st.params.channels = request.channels;
+        st.params.format = request.format;
+        st.params.rate = request.rate;
+        Ok(())
+    }
+
+    fn prepare(&self, stream_id: u32) -> Result<()> {
+        let (direction, channels, format, rate, period_bytes) = {
+            let mut streams = self.streams.write().unwrap();
+            let st = streams.get_mut(stream_id as usize).ok_or(Error::StreamWithIdNotFound(stream_id))?;
+            st.state.prepare().map_err(Error::Stream)?;
+            let p = &st.params;
+            (st.direction, u32::from(p.channels), p.format, p.rate, u32::from(p.period_bytes))
+        };
+        let mut queues = self.queues.lock().unwrap();
+        queues.remove(&stream_id);
+        let (bits, bytes, signed) =
+            sample_layout(format).ok_or(Error::UnexpectedAudioBackendConfiguration)?;
+        let packed = if bits == bytes * 8 { K_FLAG_PACKED } else { 0 };
+        let asbd = AudioStreamBasicDescription {
+            sample_rate: rate_hz(rate),
+            format_id: K_AUDIO_FORMAT_LINEAR_PCM,
+            format_flags: packed | if signed { K_FLAG_SIGNED_INTEGER } else { 0 },
+            bytes_per_packet: bytes * channels,
+            frames_per_packet: 1,
+            bytes_per_frame: bytes * channels,
+            channels_per_frame: channels,
+            bits_per_channel: bits,
+            reserved: 0,
+        };
+        let context = Box::into_raw(Box::new(CallbackContext {
+            streams: self.streams.clone(),
+            stream_id: stream_id as usize,
+        }));
+        let mut queue: AudioQueueRef = ptr::null_mut();
+        let input = direction == Direction::Input;
+        // SAFETY: asbd and context outlive the call; a null run loop runs callbacks on AudioQueue's own thread.
+        let status = unsafe {
+            if input {
+                AudioQueueNewInput(&asbd, input_callback, context as *mut c_void, ptr::null(), ptr::null(), 0, &mut queue)
+            } else {
+                AudioQueueNewOutput(&asbd, output_callback, context as *mut c_void, ptr::null(), ptr::null(), 0, &mut queue)
+            }
+        };
+        let kind = if input { "input" } else { "output" };
+        if status != 0 {
+            // SAFETY: not handed to any queue
+            drop(unsafe { Box::from_raw(context) });
+            error!("coreaudio: AudioQueueNew {kind} failed: {status}");
+            return Err(Error::UnexpectedAudioBackendConfiguration);
+        }
+        log::info!(
+            "coreaudio: {kind} queue {:.0} Hz, {channels} ch, {bits} bit, period {period_bytes} B",
+            asbd.sample_rate
+        );
+        let q = Queue { queue, context };
+        let buffer_size = period_bytes.max(bytes * channels * 256);
+        for _ in 0..QUEUE_BUFFERS {
+            let mut buf: AudioQueueBufferRef = ptr::null_mut();
+            // SAFETY: valid queue; output buffers are primed with silence by the callback before they are enqueued,
+            // input buffers go to the queue empty to be recorded into
+            unsafe {
+                if AudioQueueAllocateBuffer(queue, buffer_size, &mut buf) == 0 {
+                    if input {
+                        AudioQueueEnqueueBuffer(queue, buf, 0, ptr::null());
+                    } else {
+                        output_callback(context as *mut c_void, queue, buf);
+                    }
+                }
+            }
+        }
+        queues.insert(stream_id, q);
+        Ok(())
+    }
+
+    fn release(&self, stream_id: u32) -> Result<()> {
+        let mut streams = self.streams.write().unwrap();
+        let st = streams.get_mut(stream_id as usize).ok_or(Error::StreamWithIdNotFound(stream_id))?;
+        st.state.release().map_err(Error::Stream)?;
+        drop(streams);
+        self.queues.lock().unwrap().remove(&stream_id); // disposes the queue before the buffers go
+        std::mem::take(&mut self.streams.write().unwrap()[stream_id as usize].buffers);
+        Ok(())
+    }
+
+    fn start(&self, stream_id: u32) -> Result<()> {
+        self.streams
+            .write()
+            .unwrap()
+            .get_mut(stream_id as usize)
+            .ok_or(Error::StreamWithIdNotFound(stream_id))?
+            .state
+            .start()
+            .map_err(Error::Stream)?;
+        if let Some(q) = self.queues.lock().unwrap().get(&stream_id) {
+            // SAFETY: valid queue
+            let status = unsafe { AudioQueueStart(q.queue, ptr::null()) };
+            if status != 0 {
+                error!("coreaudio: AudioQueueStart failed: {status}");
+            }
+        }
+        Ok(())
+    }
+
+    fn stop(&self, stream_id: u32) -> Result<()> {
+        self.streams
+            .write()
+            .unwrap()
+            .get_mut(stream_id as usize)
+            .ok_or(Error::StreamWithIdNotFound(stream_id))?
+            .state
+            .stop()
+            .map_err(Error::Stream)?;
+        if let Some(q) = self.queues.lock().unwrap().get(&stream_id) {
+            // SAFETY: valid queue; pausing (unlike AudioQueueStop) keeps the primed buffers for the next start
+            unsafe { AudioQueuePause(q.queue) };
+        }
+        Ok(())
+    }
+
+    #[cfg(test)]
+    fn as_any(&self) -> &dyn std::any::Any {
+        self
+    }
+}
