Subject: [PATCH] drm/virtio: advertise the linear modifier and ARGB8888 for scanout

virtio-gpu sets fb_modifiers_not_supported, so a compositor that allocates its
scanout images with explicit modifiers (gamescope with Vulkan and
VK_EXT_image_drm_format_modifier, which only offers LINEAR on Venus/macOS) gets
"format XR24 and modifier 0x0 not supported for scan-out" and exits. Resources
are always scanned out linearly, so advertise DRM_FORMAT_MOD_LINEAR on the
planes and accept framebuffers with that modifier (and no other).

gamescope also needs ARGB8888 among the plane formats it collects (it creates
its flippable blank texture in that format); fb_create already accepts it, so
the primary plane lists it too. Still the same in 7.4-rc1.
---
diff -ruN a/drivers/gpu/drm/virtio/virtgpu_display.c b/drivers/gpu/drm/virtio/virtgpu_display.c
--- a/drivers/gpu/drm/virtio/virtgpu_display.c	2026-11-06 19:18:30
+++ b/drivers/gpu/drm/virtio/virtgpu_display.c	2026-11-08 00:50:21
@@ -329,6 +329,11 @@
 	    mode_cmd->pixel_format != DRM_FORMAT_HOST_ARGB8888)
 		return ERR_PTR(-ENOENT);
 
+	/* resources are scanned out row by row: only the linear layout */
+	if ((mode_cmd->flags & DRM_MODE_FB_MODIFIERS) &&
+	    mode_cmd->modifier[0] != DRM_FORMAT_MOD_LINEAR)
+		return ERR_PTR(-EINVAL);
+
 	/* lookup object associated with res handle */
 	obj = drm_gem_object_lookup(file_priv, mode_cmd->handles[0]);
 	if (!obj)
@@ -375,8 +380,6 @@
 	vgdev->ddev->mode_config.min_height = YRES_MIN;
 	vgdev->ddev->mode_config.max_width = XRES_MAX;
 	vgdev->ddev->mode_config.max_height = YRES_MAX;
-
-	vgdev->ddev->mode_config.fb_modifiers_not_supported = true;
 
 	for (i = 0; i < vgdev->num_scanouts; ++i) {
 		ret = vgdev_output_init(vgdev, i);
diff -ruN a/drivers/gpu/drm/virtio/virtgpu_plane.c b/drivers/gpu/drm/virtio/virtgpu_plane.c
--- a/drivers/gpu/drm/virtio/virtgpu_plane.c	2026-11-06 19:18:30
+++ b/drivers/gpu/drm/virtio/virtgpu_plane.c	2026-11-08 00:58:05
@@ -37,8 +37,19 @@
 
 static const uint32_t virtio_gpu_formats[] = {
 	DRM_FORMAT_HOST_XRGB8888,
+	/* fb_create already accepts it; gamescope needs it among the scanout formats */
+	DRM_FORMAT_HOST_ARGB8888,
 };
 
+/* Advertise the explicit linear layout, so compositors that allocate with
+ * modifiers (gamescope via Vulkan's VK_EXT_image_drm_format_modifier) can scan
+ * out: virtio-gpu resources are always linear.
+ */
+static const uint64_t virtio_gpu_modifiers[] = {
+	DRM_FORMAT_MOD_LINEAR,
+	DRM_FORMAT_MOD_INVALID
+};
+
 static const uint32_t virtio_gpu_cursor_formats[] = {
 	DRM_FORMAT_HOST_ARGB8888,
 };
@@ -602,7 +613,7 @@
 
 	plane = drmm_universal_plane_alloc(dev, struct drm_plane, dev,
 					   1 << index, &virtio_gpu_plane_funcs,
-					   formats, nformats, NULL, type, NULL);
+					   formats, nformats, virtio_gpu_modifiers, type, NULL);
 	if (IS_ERR(plane))
 		return plane;
 
