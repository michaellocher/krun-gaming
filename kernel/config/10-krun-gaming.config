CONFIG_LOCALVERSION="-krun-gaming"
# required (checked by guest/kernel-build.sh): virtio-gpu with blob alignment (upstream since 7.2), Apple TSO for FEX
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_ARM64_MEMORY_MODEL_CONTROL=y
CONFIG_ARM64_4K_PAGES=y
CONFIG_EXT4_FS=y
CONFIG_VIRTIO_FS=y
# interactive latency (Venus/DXVK wait on fences across guest and host): 1000 Hz tick and full preemption instead of
# libkrunfw's container settings (HZ=100, no preemption), as desktop Fedora does (README: performance)
CONFIG_HZ_1000=y
CONFIG_HZ=1000
CONFIG_PREEMPT=y
